// AddGlossaryTopics.idjs
// Modern UXP JavaScript (.idjs) for Adobe InDesign v18.0+
// Light Mode, Resizable & Responsive UI with Safe Emojis & Crisp SVGs
// Made with ❤️ by Rajesh Budhathoki

const indesign = require("indesign");
const {
  app,
  NothingEnum,
  PageReferenceType,
  UndoModes,
  ScriptLanguage,
} = indesign;

// Cross-version safe UXP Enum resolution
const NOTHING =
  NothingEnum && (NothingEnum.nothing ?? NothingEnum.NOTHING);
const CURRENT_PAGE =
  PageReferenceType &&
  (PageReferenceType.CURRENT_PAGE ?? PageReferenceType.currentPage);
const ENTIRE_SCRIPT =
  UndoModes && (UndoModes.ENTIRE_SCRIPT ?? UndoModes.entireScript);
const UXPSCRIPT_LANG =
  ScriptLanguage &&
  (ScriptLanguage.UXPSCRIPT ??
    ScriptLanguage.JAVASCRIPT ??
    ScriptLanguage.javascript);

// Default sample data (Word | Meaning)
const DEFAULT_SAMPLE_DATA = [
  "आदर्श पुरुष | उदाहरणीय वा आदर्श व्यक्ति",
  "अधर्म | अधर्म वा अन्याय । धर्मको विपरीत भाव वा आचरण ।",
  "आध्यात्मिक विद्या | आध्यात्मिक ज्ञान",
].join("\n");

// ============================================================================
// LIGHT MODE THEME PALETTE & CRISP SVG / EMOJI HELPERS
// ============================================================================

const THEME = {
  appBg: "#F1F5F9",
  cardBg: "#FFFFFF",
  subtleBg: "#F8FAFC",
  border: "#E2E8F0",
  borderStrong: "#CBD5E1",
  textMain: "#0F172A",
  textSecondary: "#334155",
  textMuted: "#64748B",
  primary: "#2563EB",
  primaryHover: "#1D4ED8",
  primarySoft: "#EFF6FF",
  primaryBorder: "#BFDBFE",
  successBg: "#DCFCE7",
  successText: "#15803D",
  successBorder: "#86EFAC",
  infoBg: "#DBEAFE",
  infoText: "#1D4ED8",
  infoBorder: "#93C5FD",
  warnBg: "#FEF3C7",
  warnText: "#B45309",
  warnBorder: "#FCD34D",
  dangerBg: "#FEE2E2",
  dangerHover: "#FECACA",
  dangerText: "#B91C1C",
  dangerBorder: "#FCA5A5",
  neutralBg: "#F1F5F9",
  neutralText: "#334155",
  neutralBorder: "#CBD5E1",
};

/**
 * Creates a clean icon badge container using only UXP-verified emojis
 */
function createIconBadge(emojiChar, bgColor, textColor, sizePx = 32, borderColor = null) {
  const badge = document.createElement("div");
  badge.style.display = "flex";
  badge.style.alignItems = "center";
  badge.style.justifyContent = "center";
  badge.style.width = `${sizePx}px`;
  badge.style.height = `${sizePx}px`;
  badge.style.borderRadius = "8px";
  badge.style.backgroundColor = bgColor;
  badge.style.color = textColor;
  if (borderColor) {
    badge.style.border = `1px solid ${borderColor}`;
  }
  badge.style.fontSize = `${Math.round(sizePx * 0.55)}px`;
  badge.style.flexShrink = "0";
  badge.textContent = emojiChar;
  return badge;
}

/**
 * Creates a crisp inline SVG icon that avoids UXP's black-fill bug by setting fill="none" on path
 */
function createSvgIcon(pathData, color = "#2563EB", size = 15) {
  try {
    const ns = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(ns, "svg");
    svg.setAttribute("width", String(size));
    svg.setAttribute("height", String(size));
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("fill", "none");
    svg.style.flexShrink = "0";

    const path = document.createElementNS(ns, "path");
    path.setAttribute("d", pathData);
    path.setAttribute("fill", "none");
    path.setAttribute("stroke", color);
    path.setAttribute("stroke-width", "2.2");
    path.setAttribute("stroke-linecap", "round");
    path.setAttribute("stroke-linejoin", "round");

    svg.appendChild(path);
    return svg;
  } catch (e) {
    const fallback = document.createElement("div");
    fallback.textContent = "•";
    fallback.style.color = color;
    return fallback;
  }
}

const SVG_PATHS = {
  trash: "M3 6h18M8 6V4h8v2M6 6v14h12V6M10 10v6M14 10v6",
  play: "M6 4l14 8-14 8V4z",
  copy: "M9 9h11v11H9V9zM5 15H4V4h11v1",
  close: "M18 6L6 18M6 6l12 12",
  chevronDown: "M6 9l6 6 6-6",
  chevronUp: "M18 15l-6-6-6 6",
  expand: "M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7",
};

/**
 * Creates a modern UXP-safe button without native OS bevel artifacts or broken emoji tofu boxes
 */
function createModernButton({
  label,
  svgPath = null,
  emoji = null,
  bgColor = THEME.cardBg,
  hoverBgColor = THEME.subtleBg,
  textColor = THEME.textMain,
  borderColor = THEME.borderStrong,
  padding = "9px 16px",
  fontSize = "12.5px",
  fontWeight = "600",
  fullWidth = false,
}) {
  const btn = document.createElement("div");
  btn.setAttribute("role", "button");
  btn.tabIndex = 0;
  btn.style.display = "flex";
  btn.style.flexDirection = "row";
  btn.style.alignItems = "center";
  btn.style.justifyContent = "center";
  btn.style.gap = "8px";
  btn.style.padding = padding;
  btn.style.borderRadius = "8px";
  btn.style.backgroundColor = bgColor;
  btn.style.color = textColor;
  btn.style.border = borderColor ? `1px solid ${borderColor}` : "1px solid transparent";
  btn.style.fontSize = fontSize;
  btn.style.fontWeight = fontWeight;
  btn.style.cursor = "pointer";
  btn.style.userSelect = "none";
  btn.style.flexShrink = "0";
  if (fullWidth) {
    btn.style.width = "100%";
    btn.style.boxSizing = "border-box";
  }

  let iconNode = null;
  if (svgPath) {
    iconNode = createSvgIcon(svgPath, textColor, 14);
    btn.appendChild(iconNode);
  } else if (emoji) {
    iconNode = document.createElement("div");
    iconNode.textContent = emoji;
    iconNode.style.fontSize = fontSize;
    iconNode.style.lineHeight = "1";
    btn.appendChild(iconNode);
  }

  const textNode = document.createElement("div");
  textNode.textContent = label;
  textNode.style.lineHeight = "1.2";
  btn.appendChild(textNode);

  let isDisabled = false;
  let currentBg = bgColor;
  let currentHoverBg = hoverBgColor;

  btn.addEventListener("mouseenter", () => {
    if (!isDisabled) btn.style.backgroundColor = currentHoverBg;
  });
  btn.addEventListener("mouseleave", () => {
    if (!isDisabled) btn.style.backgroundColor = currentBg;
  });

  return {
    el: btn,
    textNode,
    setLabel(newText) {
      textNode.textContent = newText;
    },
    setColors(newBg, newHover, newText, newBorder) {
      currentBg = newBg;
      currentHoverBg = newHover || newBg;
      btn.style.backgroundColor = newBg;
      btn.style.color = newText;
      btn.style.border = newBorder ? `1px solid ${newBorder}` : "1px solid transparent";
    },
    setDisabled(val) {
      isDisabled = Boolean(val);
      btn.style.opacity = isDisabled ? "0.6" : "1";
      btn.style.pointerEvents = isDisabled ? "none" : "auto";
    },
  };
}

// ============================================================================
// 1. UXP COLLECTION & DOM HELPERS
// ============================================================================

function getItem(collectionOrArray, index) {
  if (!collectionOrArray) return null;
  try {
    if (Array.isArray(collectionOrArray)) {
      return collectionOrArray[index] ?? null;
    }
    if (typeof collectionOrArray.item === "function") {
      const el = collectionOrArray.item(index);
      return el && el.isValid !== false ? el : null;
    }
    return collectionOrArray[index] ?? null;
  } catch (e) {
    return null;
  }
}

function toArray(collectionOrArray) {
  if (!collectionOrArray) return [];
  try {
    if (Array.isArray(collectionOrArray)) return collectionOrArray;
    if (
      typeof collectionOrArray.everyItem === "function" &&
      collectionOrArray.length > 0
    ) {
      const elements = collectionOrArray.everyItem().getElements();
      if (Array.isArray(elements)) return elements;
    }
    const result = [];
    const len = collectionOrArray.length || 0;
    for (let i = 0; i < len; i++) {
      const item = getItem(collectionOrArray, i);
      if (item) result.push(item);
    }
    return result;
  } catch (e) {
    return [];
  }
}

function getClassName(obj) {
  if (!obj) return "";
  try {
    if (typeof obj.constructorName === "string" && obj.constructorName) {
      return obj.constructorName;
    }
    if (obj.constructor && typeof obj.constructor.name === "string") {
      return obj.constructor.name;
    }
  } catch (e) {}
  return "";
}

function runWithUndo(fn, undoLabel) {
  try {
    if (typeof app.doScript === "function" && UXPSCRIPT_LANG && ENTIRE_SCRIPT) {
      app.doScript(fn, UXPSCRIPT_LANG, [], ENTIRE_SCRIPT, undoLabel);
      return;
    }
  } catch (e) {}
  fn();
}

function getPage(obj) {
  let curr = obj;
  let depth = 0;

  while (curr && depth < 60) {
    depth++;
    try {
      const cName = getClassName(curr);
      if (cName === "Page") {
        return curr;
      }

      if ("parentPage" in curr) {
        const pp = curr.parentPage;
        if (pp && pp.isValid !== false) {
          return pp;
        }
      }

      if ("parentTextFrames" in curr) {
        const frames = curr.parentTextFrames;
        if (frames && frames.length > 0) {
          const tf = getItem(frames, 0);
          if (tf && tf.isValid !== false) {
            if (
              "parentPage" in tf &&
              tf.parentPage &&
              tf.parentPage.isValid !== false
            ) {
              return tf.parentPage;
            }
            curr = tf;
            continue;
          }
        }
      }

      if ("storyOffset" in curr) {
        const so = curr.storyOffset;
        if (so && so.isValid !== false) {
          if (
            "parentTextFrames" in so &&
            so.parentTextFrames &&
            so.parentTextFrames.length > 0
          ) {
            const tf = getItem(so.parentTextFrames, 0);
            if (
              tf &&
              tf.isValid !== false &&
              "parentPage" in tf &&
              tf.parentPage
            ) {
              return tf.parentPage;
            }
          }
          curr = so;
          continue;
        }
      }

      if (
        cName === "Document" ||
        cName === "Application" ||
        cName === "MasterSpread"
      ) {
        return null;
      }

      curr = curr.parent;
    } catch (e) {
      break;
    }
  }
  return null;
}

function getDocumentIndexStats(doc) {
  let totalTopics = 0;
  let topicsWithRefs = 0;
  let totalPageRefs = 0;

  try {
    if (doc && doc.indexes && doc.indexes.length > 0) {
      const idx = getItem(doc.indexes, 0);
      if (idx && idx.topics) {
        const topicsArr = toArray(idx.topics);
        totalTopics = topicsArr.length;
        for (let i = 0; i < topicsArr.length; i++) {
          try {
            const refCount = topicsArr[i].pageReferences
              ? topicsArr[i].pageReferences.length
              : 0;
            totalPageRefs += refCount;
            if (refCount > 0) topicsWithRefs++;
          } catch (eRef) {}
        }
      }
    }
  } catch (e) {}

  return {
    totalTopics,
    topicsWithRefs,
    totalPageRefs,
  };
}

// ============================================================================
// 2. UXP MODAL DIALOG HELPERS (SAFE OVERLAY & STANDALONE LIGHT MODE)
// ============================================================================

async function showAlertDialog(title, message, parentOverlayHost = null) {
  return new Promise((resolve) => {
    let settled = false;

    if (parentOverlayHost) {
      const backdrop = document.createElement("div");
      backdrop.style.position = "fixed";
      backdrop.style.top = "0";
      backdrop.style.left = "0";
      backdrop.style.right = "0";
      backdrop.style.bottom = "0";
      backdrop.style.backgroundColor = "rgba(15, 23, 42, 0.45)";
      backdrop.style.display = "flex";
      backdrop.style.alignItems = "center";
      backdrop.style.justifyContent = "center";
      backdrop.style.zIndex = "9999";
      backdrop.style.padding = "24px";

      const card = document.createElement("div");
      card.style.display = "flex";
      card.style.flexDirection = "column";
      card.style.backgroundColor = THEME.cardBg;
      card.style.color = THEME.textMain;
      card.style.border = `1px solid ${THEME.borderStrong}`;
      card.style.borderRadius = "12px";
      card.style.padding = "22px 24px";
      card.style.minWidth = "380px";
      card.style.maxWidth = "540px";
      card.style.boxShadow = "0 12px 28px rgba(0,0,0,0.18)";

      const headRow = document.createElement("div");
      headRow.style.display = "flex";
      headRow.style.alignItems = "center";
      headRow.style.gap = "12px";
      headRow.style.marginBottom = "14px";

      headRow.appendChild(
        createIconBadge("💡", THEME.infoBg, THEME.infoText, 30, THEME.infoBorder)
      );

      const heading = document.createElement("div");
      heading.textContent = title || "Notice";
      heading.style.fontSize = "15px";
      heading.style.fontWeight = "700";
      heading.style.color = THEME.textMain;
      headRow.appendChild(heading);
      card.appendChild(headRow);

      const body = document.createElement("div");
      body.textContent = message || "";
      body.style.fontSize = "12.5px";
      body.style.lineHeight = "1.6";
      body.style.whiteSpace = "pre-wrap";
      body.style.maxHeight = "300px";
      body.style.overflowY = "auto";
      body.style.marginBottom = "18px";
      body.style.padding = "12px 14px";
      body.style.backgroundColor = THEME.subtleBg;
      body.style.border = `1px solid ${THEME.border}`;
      body.style.borderRadius = "8px";
      body.style.color = THEME.textSecondary;
      card.appendChild(body);

      const btnRow = document.createElement("div");
      btnRow.style.display = "flex";
      btnRow.style.justifyContent = "flex-end";

      const okBtn = createModernButton({
        label: "OK",
        emoji: "✅",
        bgColor: THEME.primary,
        hoverBgColor: THEME.primaryHover,
        textColor: "#FFFFFF",
        borderColor: THEME.primary,
        padding: "8px 22px",
      });

      const closeOverlay = () => {
        if (settled) return;
        settled = true;
        try {
          backdrop.remove();
        } catch (e) {}
        resolve();
      };

      okBtn.el.addEventListener("click", closeOverlay);
      btnRow.appendChild(okBtn.el);
      card.appendChild(btnRow);
      backdrop.appendChild(card);
      parentOverlayHost.appendChild(backdrop);
      return;
    }

    const dlg = document.createElement("dialog");
    dlg.style.padding = "0";
    dlg.style.border = `1px solid ${THEME.borderStrong}`;
    dlg.style.borderRadius = "12px";
    dlg.style.backgroundColor = THEME.cardBg;
    dlg.style.color = THEME.textMain;
    dlg.style.minWidth = "380px";
    dlg.style.maxWidth = "520px";
    dlg.style.fontFamily = "system-ui, -apple-system, sans-serif";

    const wrapper = document.createElement("div");
    wrapper.style.display = "flex";
    wrapper.style.flexDirection = "column";
    wrapper.style.padding = "22px 24px";

    const headRow = document.createElement("div");
    headRow.style.display = "flex";
    headRow.style.alignItems = "center";
    headRow.style.gap = "10px";
    headRow.style.marginBottom = "12px";

    headRow.appendChild(
      createIconBadge("💡", THEME.infoBg, THEME.infoText, 30, THEME.infoBorder)
    );

    const heading = document.createElement("div");
    heading.textContent = title || "Notice";
    heading.style.fontSize = "15px";
    heading.style.fontWeight = "700";
    heading.style.color = THEME.textMain;
    headRow.appendChild(heading);
    wrapper.appendChild(headRow);

    const body = document.createElement("div");
    body.textContent = message || "";
    body.style.fontSize = "12.5px";
    body.style.lineHeight = "1.6";
    body.style.whiteSpace = "pre-wrap";
    body.style.maxHeight = "320px";
    body.style.overflowY = "auto";
    body.style.marginBottom = "18px";
    body.style.color = THEME.textSecondary;
    wrapper.appendChild(body);

    const btnRow = document.createElement("div");
    btnRow.style.display = "flex";
    btnRow.style.justifyContent = "flex-end";

    const okBtn = createModernButton({
      label: "OK",
      emoji: "✅",
      bgColor: THEME.primary,
      hoverBgColor: THEME.primaryHover,
      textColor: "#FFFFFF",
      borderColor: THEME.primary,
      padding: "8px 22px",
    });

    const closeDialog = () => {
      if (settled) return;
      settled = true;
      try {
        dlg.close();
      } catch (e) {}
      try {
        dlg.remove();
      } catch (e) {}
      resolve();
    };

    okBtn.el.addEventListener("click", closeDialog);
    dlg.addEventListener("cancel", closeDialog);

    btnRow.appendChild(okBtn.el);
    wrapper.appendChild(btnRow);
    dlg.appendChild(wrapper);
    document.body.appendChild(dlg);
    dlg.showModal();
  });
}

async function showConfirmDialog(title, message, parentOverlayHost = null) {
  return new Promise((resolve) => {
    let settled = false;

    if (parentOverlayHost) {
      const backdrop = document.createElement("div");
      backdrop.style.position = "fixed";
      backdrop.style.top = "0";
      backdrop.style.left = "0";
      backdrop.style.right = "0";
      backdrop.style.bottom = "0";
      backdrop.style.backgroundColor = "rgba(15, 23, 42, 0.45)";
      backdrop.style.display = "flex";
      backdrop.style.alignItems = "center";
      backdrop.style.justifyContent = "center";
      backdrop.style.zIndex = "9999";
      backdrop.style.padding = "24px";

      const card = document.createElement("div");
      card.style.display = "flex";
      card.style.flexDirection = "column";
      card.style.backgroundColor = THEME.cardBg;
      card.style.color = THEME.textMain;
      card.style.border = `1px solid ${THEME.dangerBorder}`;
      card.style.borderRadius = "12px";
      card.style.padding = "22px 24px";
      card.style.minWidth = "400px";
      card.style.maxWidth = "520px";
      card.style.boxShadow = "0 12px 28px rgba(0,0,0,0.18)";

      const headRow = document.createElement("div");
      headRow.style.display = "flex";
      headRow.style.alignItems = "center";
      headRow.style.gap = "12px";
      headRow.style.marginBottom = "14px";

      headRow.appendChild(
        createIconBadge("⚠️", THEME.dangerBg, THEME.dangerText, 30, THEME.dangerBorder)
      );

      const heading = document.createElement("div");
      heading.textContent = title || "Confirm Action";
      heading.style.fontSize = "15px";
      heading.style.fontWeight = "700";
      heading.style.color = THEME.dangerText;
      headRow.appendChild(heading);
      card.appendChild(headRow);

      const body = document.createElement("div");
      body.textContent = message || "";
      body.style.fontSize = "12.5px";
      body.style.lineHeight = "1.6";
      body.style.whiteSpace = "pre-wrap";
      body.style.marginBottom = "20px";
      body.style.padding = "12px 14px";
      body.style.backgroundColor = "#FFF5F5";
      body.style.border = `1px solid ${THEME.dangerBorder}`;
      body.style.borderRadius = "8px";
      body.style.color = THEME.textMain;
      card.appendChild(body);

      const btnRow = document.createElement("div");
      btnRow.style.display = "flex";
      btnRow.style.justifyContent = "flex-end";
      btnRow.style.gap = "12px";

      const cancelBtn = createModernButton({
        label: "Cancel",
        svgPath: SVG_PATHS.close,
        bgColor: THEME.cardBg,
        hoverBgColor: THEME.subtleBg,
        textColor: THEME.textSecondary,
        borderColor: THEME.borderStrong,
        padding: "8px 18px",
      });

      const confirmBtn = createModernButton({
        label: "Yes, Delete All",
        svgPath: SVG_PATHS.trash,
        bgColor: THEME.dangerText,
        hoverBgColor: "#991B1B",
        textColor: "#FFFFFF",
        borderColor: THEME.dangerText,
        padding: "8px 18px",
      });

      const finish = (val) => {
        if (settled) return;
        settled = true;
        try {
          backdrop.remove();
        } catch (e) {}
        resolve(val);
      };

      cancelBtn.el.addEventListener("click", () => finish(false));
      confirmBtn.el.addEventListener("click", () => finish(true));

      btnRow.appendChild(cancelBtn.el);
      btnRow.appendChild(confirmBtn.el);
      card.appendChild(btnRow);
      backdrop.appendChild(card);
      parentOverlayHost.appendChild(backdrop);
      return;
    }

    resolve(false);
  });
}

// ============================================================================
// 3. DELETE ALL INDEX REFERENCES, TOPICS & MARKERS (~I) WITH STATS
// ============================================================================

function clearAllIndexData() {
  const startTime = Date.now();
  const doc = app.activeDocument;
  let removedTopics = 0;
  let removedPageRefs = 0;
  let removedMarkers = 0;

  let oldRedraw = true;
  try {
    oldRedraw = app.scriptPreferences.enableRedraw;
    app.scriptPreferences.enableRedraw = false;
  } catch (e) {}

  runWithUndo(() => {
    try {
      const indexesLen = doc.indexes.length;
      for (let i = 0; i < indexesLen; i++) {
        const idx = getItem(doc.indexes, i);
        if (!idx) continue;

        const allTopics = toArray(idx.topics);
        removedTopics += allTopics.length;

        for (let t = allTopics.length - 1; t >= 0; t--) {
          const topic = allTopics[t];
          try {
            if (topic.pageReferences && topic.pageReferences.length > 0) {
              removedPageRefs += topic.pageReferences.length;
              topic.pageReferences.everyItem().remove();
            }
          } catch (eRef) {}
        }

        try {
          if (idx.topics && idx.topics.length > 0) {
            idx.topics.everyItem().remove();
          }
        } catch (eTop) {}

        try {
          if (typeof idx.removeUnusedTopics === "function") {
            idx.removeUnusedTopics();
          }
        } catch (eUnused) {}
      }
    } catch (eIdx) {}

    try {
      app.findGrepPreferences = NOTHING;
      app.changeGrepPreferences = NOTHING;

      if (app.findChangeGrepOptions) {
        app.findChangeGrepOptions.includeFootnotes = true;
        app.findChangeGrepOptions.includeHiddenLayers = true;
        app.findChangeGrepOptions.includeLockedLayersForFind = true;
        app.findChangeGrepOptions.includeLockedStoriesForFind = true;
        app.findChangeGrepOptions.includeMasterPages = true;
      }

      app.findGrepPreferences.findWhat = "~I";
      app.changeGrepPreferences.changeTo = "";
      const changed = doc.changeGrep();
      if (changed && typeof changed.length === "number") {
        removedMarkers = changed.length;
      }
    } catch (eGrep) {
    } finally {
      app.findGrepPreferences = NOTHING;
      app.changeGrepPreferences = NOTHING;
    }

    try {
      if (doc.indexes.length > 0) {
        const idx = getItem(doc.indexes, 0);
        if (idx && typeof idx.update === "function") {
          idx.update();
        }
      }
    } catch (eUpd) {}
  }, "Delete All Index Data");

  try {
    app.scriptPreferences.enableRedraw = oldRedraw;
  } catch (e) {}

  return {
    removedTopics,
    removedPageRefs,
    removedMarkers,
    durationMs: Date.now() - startTime,
  };
}

// ============================================================================
// 4. DEVANAGARI-SAFE SEARCH & REFERENCE INSERTION ENGINE
// ============================================================================

function normalizeText(str) {
  if (!str) return "";
  let cleaned = String(str)
    .replace(/[\uFEFF\u200B]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  if (typeof cleaned.normalize === "function") {
    cleaned = cleaned.normalize("NFC");
  }
  return cleaned;
}

function parseGlossaryInput(rawText) {
  const rawLines = String(rawText || "").split(/\r?\n/);
  const validItems = [];
  let invalidLines = 0;
  let totalNonEmptyLines = 0;

  for (let k = 0; k < rawLines.length; k++) {
    const line = normalizeText(rawLines[k]);
    if (line === "") continue;
    totalNonEmptyLines++;

    if (line.includes("|")) {
      const pipeIndex = line.indexOf("|");
      const cleanWord = normalizeText(line.slice(0, pipeIndex));
      const cleanMeaning = normalizeText(line.slice(pipeIndex + 1));

      if (cleanWord !== "" && cleanMeaning !== "") {
        validItems.push({
          fullTopic: `${cleanWord} | ${cleanMeaning}`,
          searchWord: cleanWord,
          meaning: cleanMeaning,
        });
      } else {
        invalidLines++;
      }
    } else {
      invalidLines++;
    }
  }

  return {
    validItems,
    invalidLines,
    totalNonEmptyLines,
  };
}

function escapeGrep(str) {
  return str.replace(/([\\^$.|?*+()[\]{}~])/g, "\\$1");
}

function configureFindOptions(isCaseSensitive, isWholeWord) {
  if (app.findChangeTextOptions) {
    app.findChangeTextOptions.caseSensitive = Boolean(isCaseSensitive);
    app.findChangeTextOptions.wholeWord = Boolean(isWholeWord);
    app.findChangeTextOptions.includeFootnotes = true;
    app.findChangeTextOptions.includeHiddenLayers = true;
    app.findChangeTextOptions.includeLockedLayersForFind = true;
    app.findChangeTextOptions.includeLockedStoriesForFind = true;
    app.findChangeTextOptions.includeMasterPages = false;
  }
  if (app.findChangeGrepOptions) {
    app.findChangeGrepOptions.includeFootnotes = true;
    app.findChangeGrepOptions.includeHiddenLayers = true;
    app.findChangeGrepOptions.includeLockedLayersForFind = true;
    app.findChangeGrepOptions.includeLockedStoriesForFind = true;
    app.findChangeGrepOptions.includeMasterPages = false;
  }
}

function findMatchesForTerm(
  doc,
  wordToSearch,
  targetStyle,
  isCaseSensitive,
  isWholeWord
) {
  app.findTextPreferences = NOTHING;
  app.changeTextPreferences = NOTHING;
  configureFindOptions(isCaseSensitive, isWholeWord);

  if (targetStyle !== null) {
    app.findTextPreferences.appliedParagraphStyle = targetStyle;
  }
  app.findTextPreferences.findWhat = wordToSearch;

  let found = toArray(doc.findText());
  if (found.length > 0) {
    return found;
  }

  if (isWholeWord) {
    app.findChangeTextOptions.wholeWord = false;
    found = toArray(doc.findText());
    if (found.length > 0) {
      return found;
    }
  }

  try {
    app.findGrepPreferences = NOTHING;
    app.changeGrepPreferences = NOTHING;
    if (targetStyle !== null) {
      app.findGrepPreferences.appliedParagraphStyle = targetStyle;
    }
    const tokens = wordToSearch.split(/\s+/).map(escapeGrep);
    const grepPattern = tokens.join("[\\s~S~-~I]+");
    app.findGrepPreferences.findWhat = grepPattern;
    found = toArray(doc.findGrep());
  } catch (eGrep) {
  } finally {
    app.findGrepPreferences = NOTHING;
    app.changeGrepPreferences = NOTHING;
  }

  return found;
}

function addPageReferenceSafe(myTopic, foundText) {
  const candidates = [];

  try {
    if (foundText.insertionPoints && foundText.insertionPoints.length > 0) {
      const ip0 = getItem(foundText.insertionPoints, 0);
      if (ip0) candidates.push(ip0);
    }
  } catch (e) {}

  candidates.push(foundText);

  try {
    if (foundText.texts && foundText.texts.length > 0) {
      const t0 = getItem(foundText.texts, 0);
      if (t0) candidates.push(t0);
    }
  } catch (e) {}

  try {
    if (foundText.characters && foundText.characters.length > 0) {
      const c0 = getItem(foundText.characters, 0);
      if (c0) candidates.push(c0);
    }
  } catch (e) {}

  for (let c = 0; c < candidates.length; c++) {
    const target = candidates[c];
    if (!target) continue;

    try {
      if (CURRENT_PAGE !== undefined) {
        const ref = myTopic.pageReferences.add(target, CURRENT_PAGE);
        if (ref && ref.isValid !== false) return true;
      }
    } catch (e1) {}

    try {
      const ref = myTopic.pageReferences.add(target);
      if (ref && ref.isValid !== false) return true;
    } catch (e2) {}
  }

  return false;
}

function runCoreIndexer(
  indexData,
  targetStyle,
  startPageName,
  endPageName,
  isCaseSensitive,
  isWholeWord
) {
  const startTime = Date.now();
  const doc = app.activeDocument;
  const myIndex =
    doc.indexes.length === 0 ? doc.indexes.add() : getItem(doc.indexes, 0);

  const pagesArr = toArray(doc.pages);
  let startOffset = 0;
  let endOffset = Math.max(0, pagesArr.length - 1);
  let startMatched = false;

  for (let p = 0; p < pagesArr.length; p++) {
    const pg = pagesArr[p];
    const pgName = String(pg.name).trim();
    const pgOffset =
      typeof pg.documentOffset === "number" ? pg.documentOffset : p;

    if (!startMatched && pgName === startPageName) {
      startOffset = pgOffset;
      startMatched = true;
    }
    if (pgName === endPageName) {
      endOffset = pgOffset;
    }
  }

  if (startOffset > endOffset) {
    const temp = startOffset;
    startOffset = endOffset;
    endOffset = temp;
  }

  let newTopicsAdded = 0;
  let existingTopicsUpdated = 0;
  let newRefsAdded = 0;
  let totalRawMatches = 0;
  let duplicatesSkipped = 0;
  let outOfRangeSkipped = 0;
  const unmatchedTerms = [];
  const termDetails = [];

  for (let i = 0; i < indexData.length; i++) {
    const currentTopicString = indexData[i].fullTopic;
    const wordToSearch = indexData[i].searchWord;
    const meaningText = indexData[i].meaning;

    const foundItems = findMatchesForTerm(
      doc,
      wordToSearch,
      targetStyle,
      isCaseSensitive,
      isWholeWord
    );
    totalRawMatches += foundItems.length;

    const processedPageIds = new Set();
    const processedPageNames = new Set();
    const existingPagesList = [];

    let myTopic = null;
    try {
      const candidateTopic = myIndex.topics.itemByName(currentTopicString);
      if (candidateTopic && candidateTopic.isValid) {
        myTopic = candidateTopic;
        const existingRefs = toArray(myTopic.pageReferences);
        for (let r = 0; r < existingRefs.length; r++) {
          try {
            const srcText = existingRefs[r].sourceText;
            const existingPage = getPage(srcText);
            if (existingPage) {
              const pId = String(existingPage.id);
              const pName = String(existingPage.name);
              processedPageIds.add(pId);
              processedPageNames.add(pName);
              if (!existingPagesList.includes(pName)) {
                existingPagesList.push(pName);
              }
            }
          } catch (eExisting) {}
        }
      }
    } catch (eLookup) {}

    const uniquePageMatches = [];
    let termDuplicatesSkipped = 0;
    let termOutOfRange = 0;

    for (let j = 0; j < foundItems.length; j++) {
      const foundText = foundItems[j];
      const textPage = getPage(foundText);

      if (textPage !== null) {
        const currentOffset =
          typeof textPage.documentOffset === "number"
            ? textPage.documentOffset
            : 0;
        const pageId = String(textPage.id);
        const pageName = String(textPage.name);

        if (currentOffset >= startOffset && currentOffset <= endOffset) {
          if (
            !processedPageIds.has(pageId) &&
            !processedPageNames.has(pageName)
          ) {
            processedPageIds.add(pageId);
            processedPageNames.add(pageName);
            uniquePageMatches.push({
              foundText,
              pageId,
              pageName,
            });
          } else {
            termDuplicatesSkipped++;
            duplicatesSkipped++;
          }
        } else {
          termOutOfRange++;
          outOfRangeSkipped++;
        }
      }
    }

    if (uniquePageMatches.length === 0) {
      if (!myTopic) {
        unmatchedTerms.push(wordToSearch);
        termDetails.push({
          word: wordToSearch,
          meaning: meaningText,
          fullTopic: currentTopicString,
          status: "NOT_FOUND",
          rawMatches: foundItems.length,
          addedRefs: 0,
          duplicatesSkipped: termDuplicatesSkipped,
          outOfRange: termOutOfRange,
          pages: [],
        });
      } else {
        termDetails.push({
          word: wordToSearch,
          meaning: meaningText,
          fullTopic: currentTopicString,
          status: "EXISTS",
          rawMatches: foundItems.length,
          addedRefs: 0,
          duplicatesSkipped: termDuplicatesSkipped,
          outOfRange: termOutOfRange,
          pages: existingPagesList,
        });
      }
      continue;
    }

    let topicCreatedNow = false;
    if (!myTopic) {
      myTopic = myIndex.topics.add(currentTopicString);
      newTopicsAdded++;
      topicCreatedNow = true;
    } else {
      existingTopicsUpdated++;
    }

    let addedForThisTopic = 0;
    const newlyCapturedPages = [];
    for (let k = uniquePageMatches.length - 1; k >= 0; k--) {
      const matchObj = uniquePageMatches[k];
      if (addPageReferenceSafe(myTopic, matchObj.foundText)) {
        newRefsAdded++;
        addedForThisTopic++;
        newlyCapturedPages.unshift(matchObj.pageName);
      }
    }

    if (
      topicCreatedNow &&
      addedForThisTopic === 0 &&
      myTopic.pageReferences.length === 0
    ) {
      try {
        myTopic.remove();
        newTopicsAdded--;
        unmatchedTerms.push(wordToSearch);
        termDetails.push({
          word: wordToSearch,
          meaning: meaningText,
          fullTopic: currentTopicString,
          status: "NOT_FOUND",
          rawMatches: foundItems.length,
          addedRefs: 0,
          duplicatesSkipped: termDuplicatesSkipped,
          outOfRange: termOutOfRange,
          pages: [],
        });
      } catch (eRem) {}
    } else {
      const allPagesForTerm = existingPagesList.concat(newlyCapturedPages);
      termDetails.push({
        word: wordToSearch,
        meaning: meaningText,
        fullTopic: currentTopicString,
        status: topicCreatedNow ? "NEW" : "UPDATED",
        rawMatches: foundItems.length,
        addedRefs: addedForThisTopic,
        duplicatesSkipped: termDuplicatesSkipped,
        outOfRange: termOutOfRange,
        pages: allPagesForTerm,
      });
    }
  }

  app.findTextPreferences = NOTHING;
  app.changeTextPreferences = NOTHING;
  app.findGrepPreferences = NOTHING;
  app.changeGrepPreferences = NOTHING;

  try {
    myIndex.update();
  } catch (eUpd) {}

  return {
    totalTerms: indexData.length,
    newTopicsAdded,
    existingTopicsUpdated,
    newRefsAdded,
    totalRawMatches,
    duplicatesSkipped,
    outOfRangeSkipped,
    unmatchedTerms,
    termDetails,
    durationMs: Date.now() - startTime,
  };
}

// ============================================================================
// 5. MAIN UXP DIALOG UI (RESIZABLE, RESPONSIVE, PROPER SPACING & SAFE EMOJIS)
// ============================================================================

function createStatPill(iconEmoji, label, initialValue, accentColor, softBg, borderColor) {
  const pill = document.createElement("div");
  pill.style.display = "flex";
  pill.style.flexDirection = "row";
  pill.style.alignItems = "center";
  pill.style.gap = "12px";
  pill.style.flex = "1 1 150px";
  pill.style.minWidth = "148px";
  pill.style.padding = "12px 14px";
  pill.style.backgroundColor = THEME.cardBg;
  pill.style.border = `1px solid ${THEME.border}`;
  pill.style.borderRadius = "10px";
  pill.style.boxSizing = "border-box";
  pill.style.flexShrink = "0";

  const iconEl = createIconBadge(iconEmoji, softBg, accentColor, 36, borderColor);

  const textCol = document.createElement("div");
  textCol.style.display = "flex";
  textCol.style.flexDirection = "column";
  textCol.style.gap = "2px";

  const valEl = document.createElement("div");
  valEl.textContent = String(initialValue);
  valEl.style.fontSize = "17px";
  valEl.style.fontWeight = "700";
  valEl.style.color = accentColor || THEME.textMain;
  valEl.style.lineHeight = "1.2";

  const lblEl = document.createElement("div");
  lblEl.textContent = label;
  lblEl.style.fontSize = "11.5px";
  lblEl.style.fontWeight = "600";
  lblEl.style.color = THEME.textMuted;

  textCol.appendChild(valEl);
  textCol.appendChild(lblEl);

  pill.appendChild(iconEl);
  pill.appendChild(textCol);

  return { pill, valEl, lblEl };
}

