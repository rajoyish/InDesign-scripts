  // Expand / Collapse Toggle Bar for Detailed Breakdown (Defaulted to Collapsed!)
  const expandToggleRow = document.createElement("div");
  expandToggleRow.style.display = "flex";
  expandToggleRow.style.justifyContent = "space-between";
  expandToggleRow.style.alignItems = "center";
  expandToggleRow.style.paddingTop = "2px";
  expandToggleRow.style.flexShrink = "0";

  const btnToggleBreakdown = createModernButton({
    label: "▼ Show Per-Term Breakdown Details",
    bgColor: THEME.primarySoft,
    hoverBgColor: THEME.infoBg,
    textColor: THEME.primary,
    borderColor: THEME.primaryBorder,
    padding: "9px 14px",
    fontSize: "12px",
    fontWeight: "700",
    fullWidth: true,
  });

  expandToggleRow.appendChild(btnToggleBreakdown.el);
  statsDashboard.appendChild(expandToggleRow);

  let isBreakdownExpanded = false;
  let currentBreakdownCount = 0;

  const breakdownContainer = document.createElement("div");
  breakdownContainer.style.display = "none"; // Default collapsed
  breakdownContainer.style.flexDirection = "column";
  breakdownContainer.style.gap = "8px";
  breakdownContainer.style.maxHeight = "240px";
  breakdownContainer.style.overflowY = "auto";
  breakdownContainer.style.padding = "12px";
  breakdownContainer.style.backgroundColor = THEME.subtleBg;
  breakdownContainer.style.border = `1px solid ${THEME.borderStrong}`;
  breakdownContainer.style.borderRadius = "8px";
  breakdownContainer.style.flexShrink = "0";
  statsDashboard.appendChild(breakdownContainer);

  function setBreakdownExpanded(expanded) {
    isBreakdownExpanded = Boolean(expanded);
    if (isBreakdownExpanded) {
      breakdownContainer.style.display = "flex";
      btnToggleBreakdown.setLabel(
        `▲ Hide Per-Term Breakdown Details (${currentBreakdownCount} items)`
      );
      btnToggleBreakdown.setColors(
        THEME.subtleBg,
        THEME.border,
        THEME.textMain,
        THEME.borderStrong
      );
    } else {
      breakdownContainer.style.display = "none";
      btnToggleBreakdown.setLabel(
        `▼ Show Per-Term Breakdown Details (${currentBreakdownCount} items)`
      );
      btnToggleBreakdown.setColors(
        THEME.primarySoft,
        THEME.infoBg,
        THEME.primary,
        THEME.primaryBorder
      );
    }
  }

  btnToggleBreakdown.el.addEventListener("click", () => {
    setBreakdownExpanded(!isBreakdownExpanded);
  });

  scrollBody.appendChild(statsDashboard);

  // 2E. Instructions Box inside Scroll Body
  const instructionsText = document.createElement("div");
  instructionsText.textContent =
    "💡 Workflow: 1) Choose Filters & Paste 'Word | Meaning' lines  ➔  2) Click 'Run Indexer'  ➔  3) Click 'Show Per-Term Breakdown Details' to inspect captured pages  ➔  4) Open Window > Type & Tables > Index (Reference mode) & click 'Generate Index'.";
  instructionsText.style.fontSize = "11.5px";
  instructionsText.style.lineHeight = "1.55";
  instructionsText.style.color = THEME.textSecondary;
  instructionsText.style.backgroundColor = THEME.cardBg;
  instructionsText.style.border = `1px solid ${THEME.border}`;
  instructionsText.style.padding = "12px 14px";
  instructionsText.style.borderRadius = "8px";
  instructionsText.style.flexShrink = "0";
  scrollBody.appendChild(instructionsText);

  appShell.appendChild(scrollBody);

  // --- 3. Sticky Action Footer + Drag-to-Resize Corner Grip ---
  const footerBar = document.createElement("div");
  footerBar.style.display = "flex";
  footerBar.style.flexDirection = "column";
  footerBar.style.gap = "10px";
  footerBar.style.padding = "14px 24px 12px 24px";
  footerBar.style.backgroundColor = THEME.cardBg;
  footerBar.style.borderTop = `1px solid ${THEME.border}`;
  footerBar.style.flexShrink = "0";
  footerBar.style.position = "relative";

  const buttonRow = document.createElement("div");
  buttonRow.style.display = "flex";
  buttonRow.style.flexWrap = "wrap";
  buttonRow.style.justifyContent = "space-between";
  buttonRow.style.alignItems = "center";
  buttonRow.style.gap = "12px";

  const btnClear = createModernButton({
    label: "Delete All & Start Fresh",
    svgPath: SVG_PATHS.trash,
    bgColor: THEME.dangerBg,
    hoverBgColor: THEME.dangerHover,
    textColor: THEME.dangerText,
    borderColor: THEME.dangerBorder,
    padding: "9px 16px",
  });

  const rightBtns = document.createElement("div");
  rightBtns.style.display = "flex";
  rightBtns.style.alignItems = "center";
  rightBtns.style.gap = "10px";

  const btnClose = createModernButton({
    label: "Close",
    svgPath: SVG_PATHS.close,
    bgColor: THEME.subtleBg,
    hoverBgColor: THEME.border,
    textColor: THEME.textSecondary,
    borderColor: THEME.borderStrong,
    padding: "9px 18px",
  });

  const btnRun = createModernButton({
    label: "Run Indexer",
    svgPath: SVG_PATHS.play,
    bgColor: THEME.primary,
    hoverBgColor: THEME.primaryHover,
    textColor: "#FFFFFF",
    borderColor: THEME.primary,
    padding: "9px 22px",
    fontWeight: "700",
  });

  rightBtns.appendChild(btnClose.el);
  rightBtns.appendChild(btnRun.el);
  buttonRow.appendChild(btnClear.el);
  buttonRow.appendChild(rightBtns);
  footerBar.appendChild(buttonRow);

  const footerBottomRow = document.createElement("div");
  footerBottomRow.style.display = "flex";
  footerBottomRow.style.justifyContent = "space-between";
  footerBottomRow.style.alignItems = "center";

  const spacerLeft = document.createElement("div");
  spacerLeft.style.width = "80px";

  const creditText = document.createElement("div");
  creditText.textContent = "Made with ❤️ by Rajesh Budhathoki";
  creditText.style.textAlign = "center";
  creditText.style.fontSize = "11.5px";
  creditText.style.fontWeight = "500";
  creditText.style.color = THEME.textMuted;

  // Interactive Drag-to-Resize Grip in the bottom-right corner
  const resizeGrip = document.createElement("div");
  resizeGrip.textContent = "◢ Resize";
  resizeGrip.title = "Drag to resize window";
  resizeGrip.style.fontSize = "10.5px";
  resizeGrip.style.fontWeight = "600";
  resizeGrip.style.color = THEME.textMuted;
  resizeGrip.style.cursor = "nwse-resize";
  resizeGrip.style.userSelect = "none";
  resizeGrip.style.padding = "2px 6px";
  resizeGrip.style.borderRadius = "4px";
  resizeGrip.style.backgroundColor = THEME.subtleBg;
  resizeGrip.style.border = `1px solid ${THEME.border}`;

  footerBottomRow.appendChild(spacerLeft);
  footerBottomRow.appendChild(creditText);
  footerBottomRow.appendChild(resizeGrip);
  footerBar.appendChild(footerBottomRow);

  appShell.appendChild(footerBar);
  dialog.appendChild(appShell);
  document.body.appendChild(dialog);

  // --- Window Size Preset & Drag-to-Resize Logic ---
  btnWindowSize.el.addEventListener("click", () => {
    currentPresetIdx = (currentPresetIdx + 1) % WINDOW_PRESETS.length;
    const preset = WINDOW_PRESETS[currentPresetIdx];
    dialog.style.width = `${preset.w}px`;
    dialog.style.height = `${preset.h}px`;
    dataInput.style.height = `${preset.textareaH}px`;
    btnWindowSize.setLabel(`Size: ${preset.name}`);
  });

  let isResizing = false;
  let startX = 0;
  let startY = 0;
  let startW = 760;
  let startH = 680;

  resizeGrip.addEventListener("mousedown", (e) => {
    isResizing = true;
    startX = e.clientX;
    startY = e.clientY;
    startW = parseInt(dialog.style.width, 10) || 760;
    startH = parseInt(dialog.style.height, 10) || 680;
    e.preventDefault();
  });

  dialog.addEventListener("mousemove", (e) => {
    if (!isResizing) return;
    const newW = Math.max(560, Math.min(1150, startW + (e.clientX - startX)));
    const newH = Math.max(480, Math.min(920, startH + (e.clientY - startY)));
    dialog.style.width = `${newW}px`;
    dialog.style.height = `${newH}px`;
  });

  dialog.addEventListener("mouseup", () => {
    isResizing = false;
  });

  // --- Helper Functions to Refresh UI Stats ---
  let latestReportText = "";

  function refreshTopBarStats() {
    const docStats = getDocumentIndexStats(doc);
    const parsed = parseGlossaryInput(dataInput.value);

    statDocPages.valEl.textContent = String(pagesArr.length);
    statDocTopics.valEl.textContent = String(docStats.totalTopics);
    statDocRefs.valEl.textContent = String(docStats.totalPageRefs);
    statInputValid.valEl.textContent = String(parsed.validItems.length);

    if (parsed.invalidLines > 0) {
      liveParseBadge.textContent = `⚠️ ${parsed.validItems.length} valid  |  ${parsed.invalidLines} missing '|'`;
      liveParseBadge.style.backgroundColor = THEME.warnBg;
      liveParseBadge.style.color = THEME.warnText;
      liveParseBadge.style.border = `1px solid ${THEME.warnBorder}`;
    } else {
      liveParseBadge.textContent = `✨ ${parsed.validItems.length} valid entries ready`;
      liveParseBadge.style.backgroundColor = THEME.successBg;
      liveParseBadge.style.color = THEME.successText;
      liveParseBadge.style.border = `1px solid ${THEME.successBorder}`;
    }
  }

  function renderKpiCard(icon, title, value, textColor, bgColor, borderColor) {
    const card = document.createElement("div");
    card.style.display = "flex";
    card.style.flexDirection = "column";
    card.style.flex = "1 1 102px";
    card.style.minWidth = "100px";
    card.style.padding = "10px 12px";
    card.style.backgroundColor = bgColor || THEME.appBg;
    card.style.border = `1px solid ${borderColor || THEME.border}`;
    card.style.borderRadius = "8px";
    card.style.boxSizing = "border-box";
    card.style.flexShrink = "0";

    const v = document.createElement("div");
    v.textContent = `${icon} ${value}`;
    v.style.fontSize = "15px";
    v.style.fontWeight = "700";
    v.style.color = textColor || THEME.textMain;

    const t = document.createElement("div");
    t.textContent = title;
    t.style.fontSize = "11px";
    t.style.fontWeight = "600";
    t.style.color = THEME.textSecondary;
    t.style.marginTop = "4px";

    card.appendChild(v);
    card.appendChild(t);
    return card;
  }

  function renderRunStatsOnUI(
    stats,
    styleUsedString,
    startPageName,
    endPageName,
    isCase,
    isWhole
  ) {
    statsDashboard.style.display = "flex";
    const sec = (stats.durationMs / 1000).toFixed(2);
    const matchedCount = stats.totalTerms - stats.unmatchedTerms.length;

    statsBannerTitle.textContent = `✅ Indexing Complete (${matchedCount}/${stats.totalTerms} Terms Matched)`;
    statsBannerTitle.style.color =
      stats.unmatchedTerms.length === 0 ? THEME.successText : THEME.warnText;
    statsTimeBadge.textContent = `⏱️ ${sec}s (${stats.durationMs} ms)`;

    statsSubMeta.textContent =
      `¶ Style: ${styleUsedString}   •   📖 Pages: ${startPageName} to ${endPageName}   •   ` +
      `🔠 Case Sensitive: ${isCase ? "Yes" : "No"}   •   🎯 Whole Word: ${isWhole ? "Yes" : "No"}`;

    kpiCardsRow.innerHTML = "";
    kpiCardsRow.appendChild(
      renderKpiCard(
        "📦",
        "Terms Processed",
        stats.totalTerms,
        THEME.infoText,
        THEME.infoBg,
        THEME.infoBorder
      )
    );
    kpiCardsRow.appendChild(
      renderKpiCard(
        "✨",
        "New Topics",
        stats.newTopicsAdded,
        THEME.successText,
        THEME.successBg,
        THEME.successBorder
      )
    );
    kpiCardsRow.appendChild(
      renderKpiCard(
        "🔄",
        "Updated Topics",
        stats.existingTopicsUpdated,
        "#0369A1",
        "#E0F2FE",
        "#7DD3FC"
      )
    );
    kpiCardsRow.appendChild(
      renderKpiCard(
        "🔖",
        "Page Refs Added",
        stats.newRefsAdded,
        THEME.warnText,
        THEME.warnBg,
        THEME.warnBorder
      )
    );
    kpiCardsRow.appendChild(
      renderKpiCard(
        "🛡️",
        "Same-Page Deduped",
        stats.duplicatesSkipped,
        "#6D28D9",
        "#F3E8FF",
        "#DDD6FE"
      )
    );
    kpiCardsRow.appendChild(
      renderKpiCard(
        stats.unmatchedTerms.length > 0 ? "⚠️" : "✅",
        "Not Found",
        stats.unmatchedTerms.length,
        stats.unmatchedTerms.length > 0 ? THEME.dangerText : THEME.successText,
        stats.unmatchedTerms.length > 0 ? THEME.dangerBg : THEME.successBg,
        stats.unmatchedTerms.length > 0
          ? THEME.dangerBorder
          : THEME.successBorder
      )
    );

    breakdownContainer.innerHTML = "";
    currentBreakdownCount = stats.termDetails.length;

    for (let i = 0; i < stats.termDetails.length; i++) {
      const item = stats.termDetails[i];

      const row = document.createElement("div");
      row.style.display = "flex";
      row.style.flexDirection = "row";
      row.style.flexWrap = "wrap";
      row.style.justifyContent = "space-between";
      row.style.alignItems = "center";
      row.style.gap = "10px";
      row.style.padding = "10px 12px";
      row.style.borderRadius = "8px";
      row.style.backgroundColor = THEME.cardBg;
      row.style.border = `1px solid ${THEME.border}`;
      row.style.flexShrink = "0";

      const leftCol = document.createElement("div");
      leftCol.style.display = "flex";
      leftCol.style.flexDirection = "row";
      leftCol.style.alignItems = "center";
      leftCol.style.gap = "10px";
      leftCol.style.flex = "1 1 260px";
      leftCol.style.minWidth = "0";

      const statusBadge = document.createElement("div");
      statusBadge.style.fontSize = "10.5px";
      statusBadge.style.fontWeight = "700";
      statusBadge.style.padding = "4px 8px";
      statusBadge.style.borderRadius = "6px";
      statusBadge.style.flexShrink = "0";

      if (item.status === "NEW") {
        statusBadge.textContent = "✨ NEW";
        statusBadge.style.backgroundColor = THEME.successBg;
        statusBadge.style.color = THEME.successText;
        statusBadge.style.border = `1px solid ${THEME.successBorder}`;
      } else if (item.status === "UPDATED") {
        statusBadge.textContent = "🔄 UPDATED";
        statusBadge.style.backgroundColor = THEME.infoBg;
        statusBadge.style.color = THEME.infoText;
        statusBadge.style.border = `1px solid ${THEME.infoBorder}`;
      } else if (item.status === "EXISTS") {
        statusBadge.textContent = "✅ EXISTS";
        statusBadge.style.backgroundColor = THEME.neutralBg;
        statusBadge.style.color = THEME.neutralText;
        statusBadge.style.border = `1px solid ${THEME.neutralBorder}`;
      } else {
        statusBadge.textContent = "⚠️ NOT FOUND";
        statusBadge.style.backgroundColor = THEME.dangerBg;
        statusBadge.style.color = THEME.dangerText;
        statusBadge.style.border = `1px solid ${THEME.dangerBorder}`;
      }

      const termTextCol = document.createElement("div");
      termTextCol.style.display = "flex";
      termTextCol.style.flexDirection = "column";
      termTextCol.style.gap = "2px";
      termTextCol.style.flex = "1";
      termTextCol.style.minWidth = "0";

      const wordDiv = document.createElement("div");
      wordDiv.textContent = item.word || "(Empty Term)";
      wordDiv.style.color = THEME.textMain;
      wordDiv.style.fontSize = "13px";
      wordDiv.style.fontWeight = "700";
      wordDiv.style.lineHeight = "1.35";

      const meaningDiv = document.createElement("div");
      meaningDiv.textContent = item.meaning || "";
      meaningDiv.style.color = THEME.textMuted;
      meaningDiv.style.fontSize = "11.5px";
      meaningDiv.style.lineHeight = "1.35";

      termTextCol.appendChild(wordDiv);
      if (item.meaning) {
        termTextCol.appendChild(meaningDiv);
      }

      leftCol.appendChild(statusBadge);
      leftCol.appendChild(termTextCol);

      const rightCol = document.createElement("div");
      rightCol.style.fontSize = "11.5px";
      rightCol.style.fontWeight = "600";
      rightCol.style.padding = "5px 10px";
      rightCol.style.borderRadius = "6px";
      rightCol.style.flexShrink = "0";

      if (item.pages && item.pages.length > 0) {
        const dedupNote =
          item.duplicatesSkipped > 0
            ? ` (+${item.duplicatesSkipped} dup skipped)`
            : "";
        rightCol.textContent = `📄 Pages: ${item.pages.join(", ")}${dedupNote}`;
        rightCol.style.backgroundColor = THEME.primarySoft;
        rightCol.style.color = THEME.primary;
        rightCol.style.border = `1px solid ${THEME.primaryBorder}`;
      } else {
        rightCol.textContent =
          item.outOfRange > 0
            ? `⚠️ 0 in range (${item.outOfRange} outside)`
            : "0 matches";
        rightCol.style.backgroundColor = THEME.dangerBg;
        rightCol.style.color = THEME.dangerText;
        rightCol.style.border = `1px solid ${THEME.dangerBorder}`;
      }

      row.appendChild(leftCol);
      row.appendChild(rightCol);
      breakdownContainer.appendChild(row);
    }

    expandToggleRow.style.display = "flex";
    setBreakdownExpanded(false);

    const reportLines = [
      "=== InDesign Glossary Indexer Report ===",
      `Document: ${doc.name}`,
      `Style: ${styleUsedString} | Page Range: ${startPageName} to ${endPageName}`,
      `Case Sensitive: ${isCase ? "Yes" : "No"} | Whole Word: ${isWhole ? "Yes" : "No"}`,
      `Duration: ${sec}s`,
      `Processed: ${stats.totalTerms} | New Topics: ${stats.newTopicsAdded} | Updated: ${stats.existingTopicsUpdated}`,
      `Unique Page Refs Added: ${stats.newRefsAdded} | Same-Page Duplicates Skipped: ${stats.duplicatesSkipped}`,
      "",
      "--- Per-Term Breakdown ---",
    ];
    for (let i = 0; i < stats.termDetails.length; i++) {
      const d = stats.termDetails[i];
      reportLines.push(
        `[${d.status}] ${d.word} -> ${
          d.pages.length > 0 ? "Pages: " + d.pages.join(", ") : "Not Found"
        } (Raw hits: ${d.rawMatches}, Deduped: ${d.duplicatesSkipped})`
      );
    }
    latestReportText = reportLines.join("\n");

    refreshTopBarStats();
  }

  function renderDeleteStatsOnUI(delStats) {
    statsDashboard.style.display = "flex";
    const sec = (delStats.durationMs / 1000).toFixed(2);

    statsBannerTitle.textContent = "✅ All Index Data & Markers Cleared";
    statsBannerTitle.style.color = THEME.dangerText;
    statsTimeBadge.textContent = `⏱️ ${sec}s (${delStats.durationMs} ms)`;
    statsSubMeta.textContent =
      "Both Reference and Topic tabs in the Index panel are now empty and ready for fresh indexing.";

    kpiCardsRow.innerHTML = "";
    kpiCardsRow.appendChild(
      renderKpiCard(
        "🏷️",
        "Topics Removed",
        delStats.removedTopics,
        THEME.dangerText,
        THEME.dangerBg,
        THEME.dangerBorder
      )
    );
    kpiCardsRow.appendChild(
      renderKpiCard(
        "🔖",
        "Page Refs Removed",
        delStats.removedPageRefs,
        THEME.warnText,
        THEME.warnBg,
        THEME.warnBorder
      )
    );
    kpiCardsRow.appendChild(
      renderKpiCard(
        "✨",
        "~I Markers Stripped",
        delStats.removedMarkers,
        "#6D28D9",
        "#F3E8FF",
        "#DDD6FE"
      )
    );

    breakdownContainer.innerHTML = "";
    currentBreakdownCount = 0;
    expandToggleRow.style.display = "none";
    breakdownContainer.style.display = "none";

    latestReportText =
      `=== Index Cleared ===\nTopics Removed: ${delStats.removedTopics}\n` +
      `Page Refs Removed: ${delStats.removedPageRefs}\n~I Markers Stripped: ${delStats.removedMarkers}`;

    refreshTopBarStats();
  }

  // Initialize live stats bar on open and on textarea input
  refreshTopBarStats();
  dataInput.addEventListener("input", refreshTopBarStats);

  // Copy Report Handler
  btnCopyReport.el.addEventListener("click", async () => {
    if (!latestReportText) return;
    try {
      if (navigator && navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(latestReportText);
        btnCopyReport.setLabel("Copied!");
        setTimeout(() => {
          btnCopyReport.setLabel("Copy Report");
        }, 1500);
        return;
      }
    } catch (e) {}
    await showAlertDialog("Indexing Report", latestReportText, dialog);
  });

  // Delete All & Start Fresh Handler
  btnClear.el.addEventListener("click", async () => {
    const confirmed = await showConfirmDialog(
      "Delete All Index Data?",
      "WARNING: This will DELETE ALL previous index topics, page references, and ~I markers from the document and Index panel.\n\nContinue and start fresh?",
      dialog
    );
    if (confirmed) {
      const delStats = clearAllIndexData();
      renderDeleteStatsOnUI(delStats);
    }
  });

  // Run Indexer Handler
  btnRun.el.addEventListener("click", async () => {
    const parsed = parseGlossaryInput(dataInput.value);

    if (parsed.totalNonEmptyLines === 0) {
      await showAlertDialog(
        "No Data Provided",
        "Please paste at least one 'Word | Meaning' line into the Glossary Data box.",
        dialog
      );
      return;
    }

    if (parsed.validItems.length === 0) {
      await showAlertDialog(
        "Invalid Format",
        "No valid lines found. Ensure each line uses the 'Word | Meaning' format separated by a pipe (|).",
        dialog
      );
      return;
    }

    const selectedStyleIdx = Number(styleSelect.selectedIndex) || 0;
    const selectedStyle =
      selectedStyleIdx === 0 ? null : allStyles[selectedStyleIdx - 1] || null;

    const startPageName =
      (startPageInput.value || "").trim() !== ""
        ? startPageInput.value.trim()
        : firstPageName;
    const endPageName =
      (endPageInput.value || "").trim() !== ""
        ? endPageInput.value.trim()
        : lastPageName;

    const isCaseSensitive = Boolean(chkCaseSensitive.checked);
    const isWholeWord = Boolean(chkWholeWord.checked);

    btnRun.setLabel("Indexing...");
    btnRun.setDisabled(true);

    let prevRedraw = true;
    try {
      prevRedraw = app.scriptPreferences.enableRedraw;
      app.scriptPreferences.enableRedraw = false;
    } catch (e) {}

    let runStats = null;
    try {
      runWithUndo(() => {
        runStats = runCoreIndexer(
          parsed.validItems,
          selectedStyle,
          startPageName,
          endPageName,
          isCaseSensitive,
          isWholeWord
        );
      }, "Auto Index with Page Refs");
    } finally {
      try {
        app.scriptPreferences.enableRedraw = prevRedraw;
      } catch (e) {}
      btnRun.setLabel("Run Indexer");
      btnRun.setDisabled(false);
    }

    if (runStats) {
      const styleUsedString =
        selectedStyle !== null ? selectedStyle.name : "[Any Style]";
      renderRunStatsOnUI(
        runStats,
        styleUsedString,
        startPageName,
        endPageName,
        isCaseSensitive,
        isWholeWord
      );
    }
  });

  // Keep Dialog Open Until User Clicks "Close" or Escapes
  await new Promise((resolve) => {
    let closed = false;
    const closeMainDialog = () => {
      if (closed) return;
      closed = true;
      try {
        dialog.close();
      } catch (e) {}
      try {
        dialog.remove();
      } catch (e) {}
      resolve();
    };

    btnClose.el.addEventListener("click", closeMainDialog);
    dialog.addEventListener("cancel", closeMainDialog);
    dialog.showModal();
  });
}

await main();